gem "aws-sdk-s3", "~> 1.0", require: false # Exports::Storage (prod: S3 privado + SSE)

# ============================================================================
# HTTP client para integraciones (Meta, Google, Twilio)
# ============================================================================
gem "faraday", "~> 2.10"
